<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Petualangan Bahasa Kelas 3 🌟 - Asesmen Formatif Bab 2</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <!-- Google Fonts: Plus Jakarta Sans & OpenDyslexic / Lexend for Inclusive Reading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Lexend:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* Calming Pastel & Soft Colors Theme for ADHD/Autism/Dyslexia Friendly Focus */
    :root {
      --bg-gradient: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 50%, #fef3c7 100%);
      --font-main: 'Plus Jakarta Sans', sans-serif;
      --font-heading: 'Fredoka', cursive;
    }

    body {
      font-family: var(--font-main);
      background: var(--bg-gradient);
      min-height: 100vh;
      color: #334155;
      overflow-x: hidden;
    }

    .font-fun {
      font-family: var(--font-heading);
    }

    /* Dyslexia / Accessible Font Class Switcher */
    .dyslexia-mode {
      font-family: 'Lexend', sans-serif !important;
      letter-spacing: 0.05em !important;
      word-spacing: 0.1em !important;
      line-height: 1.8 !important;
    }

    /* Soft Floating CSS Animations */
    @keyframes floatGentle {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(1deg); }
    }

    @keyframes cloudMove {
      0% { transform: translateX(-10%); }
      50% { transform: translateX(10%); }
      100% { transform: translateX(-10%); }
    }

    @keyframes pulseSoft {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }

    .animate-float {
      animation: floatGentle 4s ease-in-out infinite;
    }

    .animate-cloud {
      animation: cloudMove 18s ease-in-out infinite;
    }

    .animate-pulse-soft {
      animation: pulseSoft 3s ease-in-out infinite;
    }

    /* Tactile Interactive Buttons for Children */
    .btn-bounce {
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .btn-bounce:hover {
      transform: translateY(-3px) scale(1.01);
      box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.2);
    }

    .btn-bounce:active {
      transform: translateY(1px) scale(0.98);
    }

    /* Accessible Scrollbars */
    .custom-scrollbar::-webkit-scrollbar {
      width: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 12px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 12px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen text-slate-700 antialiased p-3 sm:p-6 relative select-none" id="appBody">

  <!-- Background Decorative Clouds (Low contrast, soothing) -->
  <div class="fixed top-6 left-10 opacity-40 pointer-events-none animate-cloud z-0">
    <svg width="120" height="60" viewBox="0 0 120 60" fill="#cbd5e1">
      <path d="M20 45 C10 45 0 35 0 25 C0 15 12 8 22 12 C28 4 40 0 52 5 C62 0 78 4 82 14 C92 10 105 18 105 28 C115 30 120 40 110 50 Z" />
    </svg>
  </div>
  <div class="fixed bottom-10 right-8 opacity-30 pointer-events-none animate-cloud z-0" style="animation-delay: -5s;">
    <svg width="140" height="70" viewBox="0 0 120 60" fill="#93c5fd">
      <path d="M20 45 C10 45 0 35 0 25 C0 15 12 8 22 12 C28 4 40 0 52 5 C62 0 78 4 82 14 C92 10 105 18 105 28 C115 30 120 40 110 50 Z" />
    </svg>
  </div>

  <header class="w-full max-w-3xl mx-auto flex flex-wrap justify-between items-center bg-white/90 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl shadow-sm border border-sky-100 mb-4 z-10 gap-2">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center text-2xl shadow-inner animate-float">
        🌟
      </div>
      <div>
        <h1 class="font-fun text-lg sm:text-xl font-bold text-slate-800 leading-tight">Petualangan Bahasa</h1>
        <p class="text-xs font-semibold text-emerald-600">Asesmen Formatif • Bab 2 Kelas 3 SD</p>
      </div>
    </div>

    <!-- Inclusive Accessibility & Sound Controls -->
    <div class="flex items-center gap-2">
      <!-- Dyslexia Font Toggle Button -->
      <button id="btnDyslexiaToggle" onclick="toggleDyslexiaMode()" title="Mode Teks Mudah Dibaca (Ramah Disleksia)" class="px-3 py-1.5 bg-sky-50 text-sky-800 hover:bg-sky-100 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition border border-sky-200">
        <span>👁️</span> <span id="txtDyslexia">Mode Teks Jelas</span>
      </button>

      <!-- Sound FX Toggle -->
      <button id="btnSoundToggle" onclick="toggleAudio()" title="Suara Efek On/Off" class="px-3 py-1.5 bg-amber-50 text-amber-800 hover:bg-amber-100 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition border border-amber-200">
        <span id="soundIcon">🔊</span> <span id="soundText">Suara Aktif</span>
      </button>
    </div>
  </header>

  <main class="w-full max-w-3xl mx-auto flex-1 flex flex-col justify-center z-10">

    <!-- 1. LANDING PAGE / ROLE SELECTION -->
    <section id="secLanding" class="bg-white/95 rounded-3xl p-6 sm:p-10 shadow-xl border border-sky-100 text-center flex flex-col items-center relative overflow-hidden">
      <!-- Decorative Mascot -->
      <div class="w-24 h-24 bg-gradient-to-tr from-sky-100 to-emerald-100 rounded-full flex items-center justify-center text-5xl mb-4 shadow-inner animate-float">
        🐱
      </div>

      <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold tracking-wide mb-2 uppercase">
        Modul Pembelajaran
      </span>
      <h2 class="font-fun text-2xl sm:text-4xl font-bold text-slate-800 mb-3 leading-snug">
        Selamat Datang di Petualangan Kata! 📖
      </h2>
      <p class="text-slate-600 text-sm sm:text-base max-w-md mb-8 leading-relaxed">
        Mari kita ukur pemahamanmu pada Bab 2 secara menyenangkan, ramah, dan santai!
      </p>

      <!-- Role Selection Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-md">
        <!-- Student Role Card -->
        <button onclick="goToStudentLogin()" class="btn-bounce bg-emerald-500 hover:bg-emerald-600 text-white p-6 rounded-2xl font-fun text-lg font-bold shadow-lg shadow-emerald-100 flex flex-col items-center gap-3 border border-emerald-400">
          <span class="text-5xl">👦👧</span>
          <div>
            <div class="text-xl">Masuk Siswa</div>
            <div class="text-xs font-sans font-normal opacity-90 mt-0.5">Mulai Asesmen Formatif</div>
          </div>
        </button>

        <!-- Teacher Role Card -->
        <button onclick="goToTeacherLogin()" class="btn-bounce bg-sky-500 hover:bg-sky-600 text-white p-6 rounded-2xl font-fun text-lg font-bold shadow-lg shadow-sky-100 flex flex-col items-center gap-3 border border-sky-400">
          <span class="text-5xl">👩‍🏫</span>
          <div>
            <div class="text-xl">Dashboard Guru</div>
            <div class="text-xs font-sans font-normal opacity-90 mt-0.5">Lihat Rekapitulasi Nilai</div>
          </div>
        </button>
      </div>
    </section>

    <!-- 2. STUDENT LOGIN FORM -->
    <section id="secStudentLogin" class="hidden bg-white/95 rounded-3xl p-6 sm:p-8 shadow-xl border border-emerald-100">
      <button onclick="showSection('secLanding')" class="text-xs font-bold text-slate-500 hover:text-slate-800 mb-4 flex items-center gap-1.5 transition">
        ← Kembali ke Halaman Utama
      </button>

      <div class="text-center mb-6">
        <span class="text-4xl">📝</span>
        <h2 class="font-fun text-2xl font-bold text-slate-800 mt-2">Data Diri Teman Cilik</h2>
        <p class="text-xs sm:text-sm text-slate-500">Tuliskan nama dan kelasmu sebelum memulai ya!</p>
      </div>

      <form onsubmit="startQuiz(event)" class="space-y-4 max-w-md mx-auto">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Nama Lengkap Kamu:</label>
          <input type="text" id="inputStudentName" required placeholder="Contoh: Budi Santoso" class="w-full px-4 py-3.5 rounded-2xl border-2 border-slate-200 focus:border-emerald-400 focus:outline-none text-sm font-medium transition bg-slate-50 focus:bg-white">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Pilih Kelas:</label>
          <select id="selectStudentClass" required class="w-full px-4 py-3.5 rounded-2xl border-2 border-slate-200 focus:border-emerald-400 focus:outline-none text-sm font-medium transition bg-slate-50 focus:bg-white">
            <option value="">-- Pilih Kelasmu --</option>
            <option value="Kelas 3A">Kelas 3A</option>
            <option value="Kelas 3B">Kelas 3B</option>
            <option value="Kelas 3C">Kelas 3C</option>
          </select>
        </div>

        <button type="submit" class="btn-bounce w-full bg-emerald-500 hover:bg-emerald-600 text-white font-fun font-bold py-4 rounded-2xl shadow-md text-lg mt-2 flex items-center justify-center gap-2">
          <span>Siap Mulai Kuis!</span> 🚀
        </button>
      </form>
    </section>

    <!-- 3. TEACHER LOGIN FORM (PIN PROTECTED) -->
    <section id="secTeacherLogin" class="hidden bg-white/95 rounded-3xl p-6 sm:p-8 shadow-xl border border-sky-100 text-center">
      <button onclick="showSection('secLanding')" class="text-xs font-bold text-slate-500 hover:text-slate-800 mb-4 flex items-center gap-1.5 transition">
        ← Kembali
      </button>

      <div class="w-16 h-16 bg-sky-100 text-sky-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3">
        🔐
      </div>
      <h2 class="font-fun text-2xl font-bold text-slate-800 mb-1">Ruang Dashboard Guru</h2>
      <p class="text-xs text-slate-500 mb-6">Masukkan PIN Guru untuk melihat rekap nilai (PIN Default: <span class="font-bold text-sky-600">1234</span>)</p>

      <form onsubmit="verifyTeacherPin(event)" class="max-w-xs mx-auto space-y-4">
        <input type="password" id="inputTeacherPin" maxlength="6" required placeholder="Masukkan PIN" class="w-full text-center tracking-widest text-2xl font-bold px-4 py-3.5 rounded-2xl border-2 border-slate-200 focus:border-sky-400 focus:outline-none bg-slate-50">
        <p id="pinErrorMsg" class="hidden text-xs text-red-500 font-bold">⚠️ PIN salah! Silakan coba lagi.</p>
        <button type="submit" class="btn-bounce w-full bg-sky-500 hover:bg-sky-600 text-white font-fun font-bold py-3.5 rounded-2xl shadow-md">
          Buka Dashboard 📊
        </button>
      </form>
    </section>

    <!-- 4. QUIZ QUESTION SCREEN -->
    <section id="secQuiz" class="hidden bg-white/95 rounded-3xl p-5 sm:p-8 shadow-xl border border-sky-100">
      <!-- Header Info & Progress Bar -->
      <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
        <div>
          <span id="txtQuestionProgress" class="text-xs font-bold text-sky-600 uppercase tracking-wider">Soal 1 dari 5</span>
          <div class="w-36 bg-slate-100 h-2.5 rounded-full mt-1.5 overflow-hidden p-0.5">
            <div id="barProgress" class="bg-gradient-to-r from-sky-400 to-emerald-400 h-full w-1/5 rounded-full transition-all duration-300"></div>
          </div>
        </div>

        <div class="bg-amber-50 px-3.5 py-1.5 rounded-2xl border border-amber-200 flex items-center gap-1.5 shadow-sm">
          <span class="text-amber-500 text-base">⭐</span>
          <span id="txtCurrentScore" class="font-fun font-bold text-amber-800 text-sm sm:text-base">Skor: 0</span>
        </div>
      </div>

      <!-- Question & Visual SVG Container -->
      <div class="space-y-4">
        <!-- SVG Visual Container -->
        <div id="svgContainer" class="w-full h-36 sm:h-44 bg-slate-50 rounded-2xl flex items-center justify-center p-2 border border-slate-100 shadow-inner overflow-hidden">
          <!-- Injected via JavaScript -->
        </div>

        <!-- Question Text -->
        <h3 id="txtQuestion" class="font-fun text-base sm:text-xl font-bold text-slate-800 leading-snug">
          Memuat pertanyaan...
        </h3>

        <!-- Options Container -->
        <div id="optsContainer" class="grid grid-cols-1 gap-3 pt-1">
          <!-- Dynamic Answer Buttons -->
        </div>
      </div>
    </section>

    <!-- 5. STUDENT RESULT & REVIEW SCREEN -->
    <section id="secResult" class="hidden bg-white/95 rounded-3xl p-6 sm:p-8 shadow-xl border border-sky-100">
      <div class="text-center mb-6">
        <div class="text-6xl mb-2 animate-bounce" id="txtResultEmoji">🎉</div>
        <h2 class="font-fun text-2xl sm:text-3xl font-bold text-slate-800" id="txtResultTitle">Luar Biasa!</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Kamu sudah menyelesaikan Asesmen Formatif Bab 2 dengan baik!</p>

        <!-- Final Score Card -->
        <div class="my-5 inline-block bg-gradient-to-r from-emerald-400 to-teal-500 text-white p-5 rounded-3xl shadow-lg border border-emerald-300 transform transition hover:scale-105">
          <div class="text-xs font-bold uppercase tracking-wider opacity-90">Nilai Formatif Kamu</div>
          <div id="txtFinalScore" class="font-fun text-5xl sm:text-6xl font-bold my-1">100</div>
          <div id="txtScoreDetail" class="text-xs font-semibold bg-white/20 px-3 py-1 rounded-full inline-block mt-1">5 dari 5 Soal Benar</div>
        </div>
      </div>

      <!-- Pembahasan & Review List -->
      <div class="mb-6">
        <h4 class="font-fun text-base sm:text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
          <span>💡</span> <span>Umpan Balik & Pembahasan Soal:</span>
        </h4>
        <div id="feedbackReviewList" class="space-y-3 max-h-64 overflow-y-auto custom-scrollbar pr-1.5">
          <!-- Injected dynamically -->
        </div>
      </div>

      <button onclick="showSection('secLanding')" class="btn-bounce w-full bg-slate-800 hover:bg-slate-900 text-white font-fun font-bold py-4 rounded-2xl shadow-md text-base">
        Kembali ke Halaman Utama 🏠
      </button>
    </section>

    <!-- 6. TEACHER DASHBOARD SCREEN -->
    <section id="secTeacherDashboard" class="hidden bg-white/95 rounded-3xl p-5 sm:p-7 shadow-xl border border-sky-100">
      <!-- Header Dashboard -->
      <div class="flex flex-wrap justify-between items-center gap-2 mb-4 pb-3 border-b border-slate-100">
        <div>
          <h2 class="font-fun text-xl font-bold text-slate-800">📊 Rekapitulasi Asesmen Formatif</h2>
          <p class="text-xs text-slate-500">Hasil Belajar Bahasa Indonesia Bab 2 Kelas 3 SD</p>
        </div>
        <button onclick="showSection('secLanding')" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">
          Keluar 🚪
        </button>
      </div>

      <!-- Quick Statistics -->
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-emerald-50 p-3.5 rounded-2xl border border-emerald-100">
          <div class="text-xs text-emerald-700 font-bold">Total Siswa Mengerjakan</div>
          <div id="statTotalStudents" class="font-fun text-2xl sm:text-3xl font-bold text-emerald-800">0</div>
        </div>
        <div class="bg-sky-50 p-3.5 rounded-2xl border border-sky-100">
          <div class="text-xs text-sky-700 font-bold">Rata-Rata Nilai Formatif</div>
          <div id="statAverageScore" class="font-fun text-2xl sm:text-3xl font-bold text-sky-800">0</div>
        </div>
      </div>

      <!-- Actions Bar -->
      <div class="flex flex-col sm:flex-row gap-2 justify-between items-center mb-3">
        <input type="text" id="inputSearchStudent" onkeyup="filterTable()" placeholder="🔍 Cari nama siswa..." class="w-full sm:w-1/2 px-3.5 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-400 bg-slate-50">
        
        <div class="flex gap-2 w-full sm:w-auto justify-end">
          <button onclick="exportToCSV()" class="px-3.5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm transition">
            📥 Unduh Excel / CSV
          </button>
          <button onclick="clearAllData()" class="px-3 py-2 bg-red-50 text-red-600 hover:bg-red-100 rounded-xl text-xs font-bold border border-red-200 transition">
            🗑️ Reset Data
          </button>
        </div>
      </div>

      <!-- Student Scores Table -->
      <div class="overflow-x-auto max-h-64 overflow-y-auto custom-scrollbar border border-slate-100 rounded-2xl">
        <table class="w-full text-left text-xs text-slate-700">
          <thead class="bg-slate-50 font-bold text-slate-600 sticky top-0 border-b border-slate-100">
            <tr>
              <th class="p-3">No</th>
              <th class="p-3">Nama Siswa</th>
              <th class="p-3">Kelas</th>
              <th class="p-3">Skor Formatif</th>
              <th class="p-3">Waktu</th>
            </tr>
          </thead>
          <tbody id="tblScoresBody">
            <!-- Dynamic Rows -->
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <footer class="w-full max-w-3xl mx-auto text-center mt-6 text-xs text-slate-400 z-10">
    Media Pembelajaran & Asesmen Formatif Digital • Bahasa Indonesia Kelas 3 SD Kurikulum Merdeka
  </footer>

  <script>
    /* -------------------------------------------------------------------
       1. DATASET ASSESSMENT BAB 2 (BAHASA INDONESIA KELAS 3 SD)
       Covers: Feelings/Emotions, Transitive/Intransitive verbs,
       Vocabulary, Huruf Kapital, and Tanda Baca.
    ------------------------------------------------------------------- */
    const quizQuestions = [
      {
        id: 1,
        question: "😊 Perhatikan gambar! Ketika mendapat hadiah kejutan dari teman, perasaan yang kita rasakan adalah...",
        svg: `<svg viewBox="0 0 200 120" class="w-full h-full"><rect width="200" height="120" fill="#fef3c7" rx="16"/><circle cx="100" cy="55" r="32" fill="#fbbf24"/><circle cx="88" cy="48" r="4" fill="#78350f"/><circle cx="112" cy="48" r="4" fill="#78350f"/><path d="M 85 62 Q 100 80 115 62" fill="none" stroke="#78350f" stroke-width="4" stroke-linecap="round"/><text x="145" y="45" font-size="22">🎁</text><text x="35" y="45" font-size="22">✨</text></svg>`,
        options: [
          "Senang dan gembira 😊",
          "Sedih dan menangis 😢",
          "Marah dan kesal 😡"
        ],
        correctIndex: 0,
        explanation: "Mendapat hadiah kejutan membuat hati kita merasa bahagia, senang, dan gembira."
      },
      {
        id: 2,
        question: "⚽ Manakah di bawah ini yang merupakan contoh KALIMAT TRANSITIF (kalimat yang memerlukan Objek)?",
        svg: `<svg viewBox="0 0 200 120" class="w-full h-full"><rect width="200" height="120" fill="#e0f2fe" rx="16"/><rect x="25" y="35" width="150" height="50" rx="12" fill="#ffffff" stroke="#38bdf8" stroke-width="2"/><text x="35" y="65" font-size="14" font-weight="bold" fill="#0284c7">Budi + menendang + bola ⚽</text></svg>`,
        options: [
          "Budi menendang bola. ⚽",
          "Lani tertawa terbahak-bahak. 😆",
          "Adik menangis tersedu-sedu. 😢"
        ],
        correctIndex: 0,
        explanation: "Kalimat transitif memiliki objek setelah kata kerja. Pada kalimat 'Budi menendang bola', 'bola' berperan sebagai objek."
      },
      {
        id: 3,
        question: "🚶 Kalimat INTRANSITIF adalah kalimat yang TIDAK membutuhkan objek. Manakah contoh kalimat intransitif?",
        svg: `<svg viewBox="0 0 200 120" class="w-full h-full"><rect width="200" height="120" fill="#f0fdf4" rx="16"/><circle cx="100" cy="50" r="20" fill="#4ade80"/><path d="M 90 75 Q 100 110 110 75" stroke="#15803d" stroke-width="6" stroke-linecap="round"/><text x="135" y="55" font-size="20">🏃</text></svg>`,
        options: [
          "Siti berlari cepat di lapangan. 🏃",
          "Ibu memasak nasi goreng. 🍳",
          "Ayah membaca koran pagi. 📰"
        ],
        correctIndex: 0,
        explanation: "'Siti berlari cepat' tidak membutuhkan objek sasaran, sehingga tergolong kalimat intransitif."
      },
      {
        id: 4,
        question: "👑 Aturan PUEBI: Penulisan NAMA ORANG dan AWAL KALIMAT wajib menggunakan...",
        svg: `<svg viewBox="0 0 200 120" class="w-full h-full"><rect width="200" height="120" fill="#f1f5f9" rx="16"/><text x="25" y="48" font-size="15" font-weight="bold" fill="#ef4444">budi pergi ke sekolah ❌</text><text x="25" y="85" font-size="15" font-weight="bold" fill="#16a34a">Budi pergi ke sekolah ✅</text><text x="165" y="85" font-size="18">👑</text></svg>`,
        options: [
          "Huruf KAPITAL (Besar) 👑",
          "Huruf kecil semua 🐜",
          "Tanda Seru ❗"
        ],
        correctIndex: 0,
        explanation: "Huruf pertama pada awal kalimat dan nama orang harus ditulis dengan Huruf Kapital."
      },
      {
        id: 5,
        question: "🛑 Tanda baca yang tepat untuk mengakhiri kalimat pernyataan atau berita adalah...",
        svg: `<svg viewBox="0 0 200 120" class="w-full h-full"><rect width="200" height="120" fill="#fce7f3" rx="16"/><text x="20" y="65" font-size="13" font-weight="bold" fill="#9d174d">"Kami belajar Bahasa Indonesia."</text><circle cx="178" cy="62" r="6" fill="#dc2626"/></svg>`,
        options: [
          "Tanda Titik ( . ) 🛑",
          "Tanda Tanya ( ? ) ❓",
          "Tanda Seru ( ! ) ❗"
        ],
        correctIndex: 0,
        explanation: "Kalimat berita/pernyataan selalu diakhiri dengan Tanda Titik (.)."
      }
    ];

    /* -------------------------------------------------------------------
       2. APP STATE VARIABLES
    ------------------------------------------------------------------- */
    let currentStudent = { name: "", class: "" };
    let currentQuestionIdx = 0;
    let score = 0;
    let studentAnswers = [];
    let isAudioOn = true;
    let isDyslexiaMode = false;

    /* -------------------------------------------------------------------
       3. INCLUSIVE ACCESSIBILITY & AUDIO SYNTHESIZER
    ------------------------------------------------------------------- */
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playTone(freq, type, duration) {
      if (!isAudioOn) return;
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    function playSound(type) {
      if (type === 'correct') {
        playTone(523.25, 'sine', 0.15); // C5
        setTimeout(() => playTone(659.25, 'sine', 0.2), 120); // E5
      } else if (type === 'wrong') {
        playTone(220, 'triangle', 0.25); // A3
      } else if (type === 'fanfare') {
        confetti({ particleCount: 90, spread: 60, origin: { y: 0.6 } });
      }
    }

    function toggleAudio() {
      isAudioOn = !isAudioOn;
      document.getElementById('soundIcon').innerText = isAudioOn ? "🔊" : "🔇";
      document.getElementById('soundText').innerText = isAudioOn ? "Suara Aktif" : "Mute";
    }

    function toggleDyslexiaMode() {
      isDyslexiaMode = !isDyslexiaMode;
      const appBody = document.getElementById('appBody');
      const txtDyslexia = document.getElementById('txtDyslexia');

      if (isDyslexiaMode) {
        appBody.classList.add('dyslexia-mode');
        txtDyslexia.innerText = "Teks Standar";
      } else {
        appBody.classList.remove('dyslexia-mode');
        txtDyslexia.innerText = "Mode Teks Jelas";
      }
    }

    /* -------------------------------------------------------------------
       4. SECTION NAVIGATION CONTROLLER
    ------------------------------------------------------------------- */
    function showSection(sectionId) {
      const sections = ['secLanding', 'secStudentLogin', 'secTeacherLogin', 'secQuiz', 'secResult', 'secTeacherDashboard'];
      sections.forEach(id => {
        document.getElementById(id).classList.add('hidden');
      });
      document.getElementById(sectionId).classList.remove('hidden');
    }

    function goToStudentLogin() {
      showSection('secStudentLogin');
    }

    function goToTeacherLogin() {
      document.getElementById('inputTeacherPin').value = '';
      document.getElementById('pinErrorMsg').classList.add('hidden');
      showSection('secTeacherLogin');
    }

    function verifyTeacherPin(e) {
      e.preventDefault();
      const pin = document.getElementById('inputTeacherPin').value;
      if (pin === "1234") {
        renderTeacherDashboard();
        showSection('secTeacherDashboard');
      } else {
        document.getElementById('pinErrorMsg').classList.remove('hidden');
      }
    }

    /* -------------------------------------------------------------------
       5. QUIZ ENGINE LOGIC
    ------------------------------------------------------------------- */
    function startQuiz(e) {
      e.preventDefault();
      currentStudent.name = document.getElementById('inputStudentName').value.trim();
      currentStudent.class = document.getElementById('selectStudentClass').value;
      
      currentQuestionIdx = 0;
      score = 0;
      studentAnswers = [];

      showSection('secQuiz');
      loadQuestion();
    }

    function loadQuestion() {
      const q = quizQuestions[currentQuestionIdx];
      document.getElementById('txtQuestionProgress').innerText = `Soal ${currentQuestionIdx + 1} dari ${quizQuestions.length}`;
      document.getElementById('barProgress').style.width = `${((currentQuestionIdx + 1) / quizQuestions.length) * 100}%`;
      document.getElementById('txtCurrentScore').innerText = `Skor: ${score}`;

      document.getElementById('svgContainer').innerHTML = q.svg;
      document.getElementById('txtQuestion').innerText = q.question;

      const optsBox = document.getElementById('optsContainer');
      optsBox.innerHTML = '';

      q.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.className = "btn-bounce w-full text-left p-4 rounded-2xl border-2 border-slate-100 hover:border-sky-300 bg-white font-medium text-sm sm:text-base text-slate-700 shadow-sm transition flex items-center justify-between";
        btn.innerHTML = `<span>${optText}</span> <span class="text-slate-300 text-xs">➔</span>`;
        btn.onclick = () => selectAnswer(idx);
        optsBox.appendChild(btn);
      });
    }

    function selectAnswer(chosenIdx) {
      const q = quizQuestions[currentQuestionIdx];
      const isCorrect = (chosenIdx === q.correctIndex);

      if (isCorrect) {
        score += 20;
        playSound('correct');
      } else {
        playSound('wrong');
      }

      studentAnswers.push({
        questionId: q.id,
        questionText: q.question,
        chosen: q.options[chosenIdx],
        correct: q.options[q.correctIndex],
        isCorrect: isCorrect,
        explanation: q.explanation
      });

      currentQuestionIdx++;

      if (currentQuestionIdx < quizQuestions.length) {
        loadQuestion();
      } else {
        finishQuiz();
      }
    }

    function finishQuiz() {
      saveScoreToStorage();

      document.getElementById('txtFinalScore').innerText = score;
      document.getElementById('txtScoreDetail').innerText = `${score / 20} dari ${quizQuestions.length} Soal Benar`;

      if (score >= 80) {
        document.getElementById('txtResultEmoji').innerText = "🏆";
        document.getElementById('txtResultTitle').innerText = "Hebat Sekali!";
        playSound('fanfare');
      } else {
        document.getElementById('txtResultEmoji').innerText = "👏";
        document.getElementById('txtResultTitle').innerText = "Bagus! Tetap Semangat!";
      }

      // Render Feedback / Pembahasan List
      const reviewBox = document.getElementById('feedbackReviewList');
      reviewBox.innerHTML = '';

      studentAnswers.forEach((ans, i) => {
        const item = document.createElement('div');
        item.className = `p-3.5 rounded-2xl border text-xs sm:text-sm ${ans.isCorrect ? 'bg-emerald-50 border-emerald-200' : 'bg-rose-50 border-rose-200'}`;
        item.innerHTML = `
          <div class="font-bold text-slate-800 mb-1">Soal ${i + 1}: ${ans.isCorrect ? '🟢 Benar (+20)' : '🔴 Perlu Ditinjau (+0)'}</div>
          <div class="text-slate-600 mb-1"><strong>Jawaban Kamu:</strong> ${ans.chosen}</div>
          ${!ans.isCorrect ? `<div class="text-emerald-700 font-semibold mb-1"><strong>Kunci Jawaban:</strong> ${ans.correct}</div>` : ''}
          <div class="text-slate-600 italic mt-1.5 bg-white/70 p-2.5 rounded-xl border border-slate-100">💡 <strong>Penjelasan:</strong> ${ans.explanation}</div>
        `;
        reviewBox.appendChild(item);
      });

      showSection('secResult');
    }

    /* -------------------------------------------------------------------
       6. LOCALSTORAGE & TEACHER DASHBOARD LOGIC
    ------------------------------------------------------------------- */
    function saveScoreToStorage() {
      const records = JSON.parse(localStorage.getItem('quiz_bab2_records') || '[]');
      const newRecord = {
        name: currentStudent.name,
        class: currentStudent.class,
        score: score,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      };
      records.push(newRecord);
      localStorage.setItem('quiz_bab2_records', JSON.stringify(records));
    }

    function renderTeacherDashboard() {
      const records = JSON.parse(localStorage.getItem('quiz_bab2_records') || '[]');
      const tbody = document.getElementById('tblScoresBody');
      tbody.innerHTML = '';

      let totalScore = 0;

      records.forEach((rec, idx) => {
        totalScore += rec.score;
        const tr = document.createElement('tr');
        tr.className = "border-b border-slate-100 hover:bg-slate-50 transition";
        tr.innerHTML = `
          <td class="p-3 font-medium text-slate-400">${idx + 1}</td>
          <td class="p-3 font-bold text-slate-800">${rec.name}</td>
          <td class="p-3"><span class="px-2.5 py-1 bg-sky-100 text-sky-700 rounded-lg font-semibold">${rec.class}</span></td>
          <td class="p-3 font-bold ${rec.score >= 80 ? 'text-emerald-600' : 'text-amber-600'}">${rec.score}</td>
          <td class="p-3 text-slate-400">${rec.time}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('statTotalStudents').innerText = records.length;
      document.getElementById('statAverageScore').innerText = records.length ? Math.round(totalScore / records.length) : 0;
    }

    function filterTable() {
      const query = document.getElementById('inputSearchStudent').value.toLowerCase();
      const rows = document.querySelectorAll('#tblScoresBody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
      });
    }

    function clearAllData() {
      if (confirm("Apakah Bapak/Ibu guru yakin ingin menghapus seluruh data rekap nilai?")) {
        localStorage.removeItem('quiz_bab2_records');
        renderTeacherDashboard();
      }
    }

    function exportToCSV() {
      const records = JSON.parse(localStorage.getItem('quiz_bab2_records') || '[]');
      if (records.length === 0) {
        alert("Belum ada data nilai siswa untuk diunduh.");
        return;
      }

      let csv = "No,Nama Siswa,Kelas,Skor Formatif,Waktu\n";
      records.forEach((r, i) => {
        csv += `${i + 1},"${r.name}",${r.class},${r.score},"${r.time}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Rekap_Asesmen_Formatif_Bab2_Bahasa_Indonesia_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    }
  </script>
</body>
