    <!-- Firebase Standard Integration -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot, getDocs, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Variables & State
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'kuis-bahasa-indonesia-kelas-3';
        let db = null;
        let auth = null;
        let user = null;
        let studentResults = [];

        // Try initializing Firebase safely
        try {
            if (typeof __firebase_config !== 'undefined') {
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                // Authenticate first
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    signInWithCustomToken(auth, __initial_auth_token).then(res => {
                        user = res.user;
                        initFirestoreSync();
                    }).catch(() => {
                        signInAnonymously(auth).then(res => {
                            user = res.user;
                            initFirestoreSync();
                        });
                    });
                } else {
                    signInAnonymously(auth).then(res => {
                        user = res.user;
                        initFirestoreSync();
                    });
                }
            } else {
                fallbackLocalStorage();
            }
        } catch (e) {
            console.warn("Firebase fallback to LocalStorage:", e);
            fallbackLocalStorage();
        }

        function initFirestoreSync() {
            if (!db || !user) return;
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'quiz_results');
            onSnapshot(colRef, (snapshot) => {
                studentResults = [];
                snapshot.forEach((doc) => {
                    studentResults.push({ id: doc.id, ...doc.data() });
                });
                studentResults.sort((a, b) => b.timestamp - a.timestamp);
                window.studentResults = studentResults;
                if (typeof window.renderResultsTable === 'function') {
                    window.renderResultsTable();
                }
            }, (err) => {
                console.error("Firestore sync error:", err);
                fallbackLocalStorage();
            });
        }

        function fallbackLocalStorage() {
            const localData = localStorage.getItem('quiz_results_data');
            if (localData) {
                try { studentResults = JSON.parse(localData); } catch (e) { studentResults = []; }
            }
            window.studentResults = studentResults;
        }

        // Global helper to save results
        window.saveQuizResultToCloud = async function(data) {
            studentResults.unshift(data);
            localStorage.setItem('quiz_results_data', JSON.stringify(studentResults));
            window.studentResults = studentResults;

            if (db && user) {
                try {
                    const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'quiz_results');
                    await addDoc(colRef, data);
                } catch (err) {
                    console.error("Failed writing to Firestore:", err);
                }
            }
        };

        // Global helper to clear data
        window.clearAllDataCloud = async function() {
            localStorage.removeItem('quiz_results_data');
            if (db && user) {
                try {
                    const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'quiz_results');
                    const snapshot = await getDocs(colRef);
                    snapshot.forEach(async (d) => {
                        await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'quiz_results', d.id));
                    });
                } catch (e) {
                    console.error("Error clearing collection:", e);
                }
            }
            studentResults = [];
            window.studentResults = [];
            window.renderResultsTable();
        };
    </script>

    <script>
        // Audio Synthesizer Engine
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;
        let bgmInterval = null;
        let isBgmPlaying = false;

        function initAudio() {
            if (!audioCtx) audioCtx = new AudioContext();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        function playBGM() {
            if (bgmInterval || !isBgmPlaying) return;
            initAudio();
            const notes = [261.63, 329.63, 392.00, 523.25, 440.00, 349.23, 392.00, 329.63];
            let step = 0;

            bgmInterval = setInterval(() => {
                if (!isBgmPlaying) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(notes[step % notes.length], audioCtx.currentTime);
                gain.gain.setValueAtTime(0.025, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.35);
                step++;
            }, 400);
        }

        function stopBGM() {
            if (bgmInterval) {
                clearInterval(bgmInterval);
                bgmInterval = null;
            }
        }

        function toggleBGM() {
            initAudio();
            isBgmPlaying = !isBgmPlaying;
            const bgmIcon = document.getElementById('bgm-icon');
            const bgmText = document.getElementById('bgm-text');

            if (isBgmPlaying) {
                bgmIcon.innerText = '🎵';
                if (bgmText) bgmText.innerText = 'Musik On';
                playBGM();
            } else {
                bgmIcon.innerText = '🔇';
                if (bgmText) bgmText.innerText = 'Musik Off';
                stopBGM();
            }
        }

        function playSfx(type) {
            initAudio();
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;

            if (type === 'correct') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.15);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } else if (type === 'wrong') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(130, now + 0.25);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } else if (type === 'win') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.45);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                osc.start(now);
                osc.stop(now + 0.5);
            }
        }

        // Quiz Question Data
        const quizData = [
            {
                category: "Struktur Cerita • Peta Cerita",
                question: "Sore hari di lapangan desa, Budi dan Lani bersiap bermain bola bersama. Kejadian ini berada di bagian...",
                svg: `<svg viewBox="0 0 200 120" class="w-full h-full">
                        <rect width="200" height="120" rx="12" fill="#E0F2FE"/>
                        <circle cx="160" cy="30" r="16" fill="#FDE047"/>
                        <path d="M 0 90 Q 100 70 200 90 L 200 120 L 0 120 Z" fill="#86EFAC"/>
                        <circle cx="60" cy="65" r="12" fill="#FDBA74"/>
                        <rect x="52" y="77" width="16" height="20" rx="4" fill="#3B82F6"/>
                        <circle cx="120" cy="65" r="12" fill="#FDBA74"/>
                        <rect x="112" y="77" width="16" height="20" rx="4" fill="#EC4899"/>
                        <circle cx="90" cy="92" r="8" fill="#FFFFFF" stroke="#334155" stroke-width="2"/>
                      </svg>`,
                options: [
                    { text: "Awal Cerita (Pengenalan)", correct: true },
                    { text: "Tengah Cerita (Masalah Utama)", correct: false },
                    { text: "Akhir Cerita (Penyelesaian)", correct: false }
                ],
                explanation: "Bagian Awal Cerita bertugas mengenalkan tokoh (Budi & Lani), tempat (lapangan), dan situasi awal."
            },
            {
                category: "Struktur Cerita • Peta Cerita",
                question: "Saat sedang seru mengejar bola, Budi tiba-tiba tersandung dan terjatuh. Kejadian ini terdapat di bagian...",
                svg: `<svg viewBox="0 0 200 120" class="w-full h-full">
                        <rect width="200" height="120" rx="12" fill="#FEF3C7"/>
                        <path d="M 0 90 Q 100 75 200 90 L 200 120 L 0 120 Z" fill="#86EFAC"/>
                        <circle cx="75" cy="80" r="11" fill="#FDBA74"/>
                        <rect x="50" y="85" width="22" height="12" rx="3" fill="#3B82F6" transform="rotate(-15 50 85)"/>
                        <path d="M 90 75 L 105 70 M 92 85 L 108 82" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
                        <circle cx="130" cy="85" r="8" fill="#FFFFFF" stroke="#334155" stroke-width="2"/>
                      </svg>`,
                options: [
                    { text: "Awal Cerita", correct: false },
                    { text: "Tengah Cerita (Masalah)", correct: true },
                    { text: "Akhir Cerita", correct: false }
                ],
                explanation: "Bagian Tengah Cerita memuat kejadian penting, kejutan, atau masalah utama yang dialami oleh tokoh."
            },
            {
                category: "Pemahaman Isi • Kalimat Rumpang",
                question: "Lengkapi kalimat berikut: \"Lani melihat Budi jatuh, lalu ia segera ... Budi untuk berdiri kembali.\"",
                svg: `<svg viewBox="0 0 200 120" class="w-full h-full">
                        <rect width="200" height="120" rx="12" fill="#F0FDF4"/>
                        <path d="M 0 90 Q 100 80 200 90 L 200 120 L 0 120 Z" fill="#86EFAC"/>
                        <circle cx="80" cy="65" r="11" fill="#FDBA74"/>
                        <rect x="72" y="76" width="16" height="20" rx="4" fill="#EC4899"/>
                        <circle cx="105" cy="72" r="11" fill="#FDBA74"/>
                        <rect x="97" y="83" width="16" height="16" rx="4" fill="#3B82F6"/>
                        <path d="M 92 50 C 92 45, 85 45, 85 50 C 85 55, 92 58, 92 62 C 92 58, 99 55, 99 50 C 99 45, 92 45, 92 50 Z" fill="#EF4444"/>
                      </svg>`,
                options: [
                    { text: "membantu", correct: true },
                    { text: "menertawakan", correct: false },
                    { text: "meninggalkan", correct: false }
                ],
                explanation: "Kata 'membantu' adalah tindakan terpuji dan paling tepat sesuai alur cerita."
            },
            {
                category: "Kaidah PUEBI • Huruf Kapital",
                question: "Manakah penulisan kalimat yang BENAR sesuai aturan penggunaan huruf kapital?",
                svg: `<svg viewBox="0 0 200 120" class="w-full h-full">
                        <rect width="200" height="120" rx="12" fill="#F3E8FF"/>
                        <rect x="50" y="30" width="100" height="60" rx="8" fill="#FFFFFF" stroke="#8B5CF6" stroke-width="3"/>
                        <line x1="100" y1="30" x2="100" y2="90" stroke="#8B5CF6" stroke-width="2" stroke-dasharray="3,3"/>
                        <text x="62" y="58" font-family="Fredoka" font-size="22" font-weight="bold" fill="#8B5CF6">A b c</text>
                        <text x="112" y="58" font-family="Fredoka" font-size="22" font-weight="bold" fill="#10B981">A B C</text>
                      </svg>`,
                options: [
                    { text: "budi dan lani bermain bersama.", correct: false },
                    { text: "Budi dan Lani bermain bersama.", correct: true },
                    { text: "budi dan Lani Bermain bersama.", correct: false }
                ],
                explanation: "Awal kalimat dan nama orang (Budi & Lani) WAJIB diawali huruf kapital (besar)."
            },
            {
                category: "Kaidah PUEBI • Tanda Baca",
                question: "Tanda baca apakah yang tepat untuk diletakkan pada AKHIR kalimat berita?",
                svg: `<svg viewBox="0 0 200 120" class="w-full h-full">
                        <rect width="200" height="120" rx="12" fill="#FEF2F2"/>
                        <circle cx="100" cy="55" r="16" fill="#EF4444"/>
                        <text x="100" y="100" font-family="Fredoka" font-size="16" font-weight="bold" fill="#991B1B" text-anchor="middle">Tanda Titik ( . )</text>
                      </svg>`,
                options: [
                    { text: "Tanda Titik ( . )", correct: true },
                    { text: "Tanda Tanya ( ? )", correct: false },
                    { text: "Tanda Koma ( , )", correct: false }
                ],
                explanation: "Tanda Titik ( . ) digunakan untuk mengakhiri kalimat berita atau pernyataan."
            }
        ];

        // State Variables
        let currentStudent = { name: '', class: '' };
        let currentIdx = 0;
        let score = 0;
        let answered = false;
        let userAnswers = [];

        // Screen Navigation Function
        function showScreen(screenId) {
            const screens = ['role-screen', 'student-form-screen', 'quiz-screen', 'result-screen', 'teacher-auth-screen', 'teacher-dashboard-screen'];
            screens.forEach(s => {
                const el = document.getElementById(s);
                if (el) el.classList.add('hidden');
            });

            const target = document.getElementById(screenId);
            if (target) target.classList.remove('hidden');

            const header = document.getElementById('main-header');
            if (screenId === 'teacher-dashboard-screen') {
                header.classList.add('hidden');
            } else {
                header.classList.remove('hidden');
            }

            if (screenId === 'teacher-dashboard-screen') {
                renderResultsTable();
            }
        }

        function goToStudentForm() {
            showScreen('student-form-screen');
        }

        function goToTeacherAuth() {
            document.getElementById('teacher-pin').value = '';
            document.getElementById('pin-error').classList.add('hidden');
            showScreen('teacher-auth-screen');
        }

        function verifyTeacherPIN(e) {
            e.preventDefault();
            const pin = document.getElementById('teacher-pin').value;
            if (pin === '1234') {
                showScreen('teacher-dashboard-screen');
            } else {
                document.getElementById('pin-error').classList.remove('hidden');
            }
        }

        function startQuiz(e) {
            e.preventDefault();
            const name = document.getElementById('student-name').value.trim();
            const studentClass = document.getElementById('student-class').value;

            if (!name) return;

            currentStudent = { name: name, class: studentClass };
            document.getElementById('display-student-info').innerText = `${name} (${studentClass})`;

            currentIdx = 0;
            score = 0;
            userAnswers = [];

            showScreen('quiz-screen');
            loadQuestion();
        }

        function loadQuestion() {
            answered = false;
            document.getElementById('feedback-alert').classList.add('hidden');
            document.getElementById('next-btn').classList.add('hidden');

            const q = quizData[currentIdx];
            document.getElementById('q-category').innerText = q.category;
            document.getElementById('q-text').innerText = q.question;
            document.getElementById('q-counter').innerText = `Soal ${currentIdx + 1} dari ${quizData.length}`;
            document.getElementById('score-counter').innerText = `⭐ Skor: ${score}`;
            document.getElementById('progress-bar').style.width = `${((currentIdx + 1) / quizData.length) * 100}%`;
            
            document.getElementById('illustration-box').innerHTML = q.svg;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            q.options.forEach((opt, i) => {
                const btn = document.createElement('button');
                btn.className = `option-btn w-full text-left p-3 rounded-2xl border-2 border-slate-200 bg-white hover:border-sky-300 hover:bg-sky-50/60 font-bold text-slate-700 transition-all active:scale-98 flex items-center justify-between text-xs sm:text-sm shadow-sm`;
                btn.onclick = () => selectOption(i, btn);
                btn.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-sky-100 text-sky-700 font-black text-xs flex items-center justify-center border border-sky-200 flex-shrink-0">
                            ${String.fromCharCode(65 + i)}
                        </span>
                        <span class="leading-snug">${opt.text}</span>
                    </div>
                    <span class="status-icon text-base"></span>
                `;
                optionsContainer.appendChild(btn);
            });
        }

        function selectOption(idx, btn) {
            if (answered) return;
            answered = true;

            const q = quizData[currentIdx];
            const isCorrect = q.options[idx].correct;
            userAnswers.push({ 
                question: q.question, 
                selected: q.options[idx].text, 
                isCorrect: isCorrect, 
                explanation: q.explanation 
            });

            const optionsContainer = document.getElementById('options-container');
            const allBtns = optionsContainer.querySelectorAll('.option-btn');
            const feedbackAlert = document.getElementById('feedback-alert');

            if (isCorrect) {
                playSfx('correct');
                score += 20;
                document.getElementById('score-counter').innerText = `⭐ Skor: ${score}`;

                btn.classList.remove('border-slate-200', 'bg-white');
                btn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
                btn.querySelector('.status-icon').innerText = '✅';

                feedbackAlert.className = 'p-2.5 rounded-2xl text-center font-bold text-xs sm:text-sm bounce-in bg-emerald-100 text-emerald-900 border-2 border-emerald-300 shadow-sm';
                feedbackAlert.innerHTML = `🎉 HEBAT! Jawabanmu Tepat Sekali!`;
                feedbackAlert.classList.remove('hidden');
            } else {
                playSfx('wrong');
                btn.classList.remove('border-slate-200', 'bg-white');
                btn.classList.add('border-rose-400', 'bg-rose-50', 'text-rose-900', 'shake');
                btn.querySelector('.status-icon').innerText = '❌';

                allBtns.forEach((b, i) => {
                    if (q.options[i].correct) {
                        b.classList.remove('border-slate-200');
                        b.classList.add('border-emerald-400', 'bg-emerald-50');
                        b.querySelector('.status-icon').innerText = '💡';
                    }
                });

                feedbackAlert.className = 'p-2.5 rounded-2xl text-center font-bold text-xs sm:text-sm bounce-in bg-amber-100 text-amber-900 border-2 border-amber-300 shadow-sm';
                feedbackAlert.innerHTML = `💪 OOPS! Tidak apa-apa, yuk pelajari jawabannya nanti!`;
                feedbackAlert.classList.remove('hidden');
            }

            allBtns.forEach(b => b.onclick = null);
            document.getElementById('next-btn').classList.remove('hidden');
        }

        function nextQuestion() {
            currentIdx++;
            if (currentIdx < quizData.length) {
                loadQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            playSfx('win');
            const correctCount = score / 20;
            const now = new Date();
            const dateStr = now.toLocaleDateString('id-ID', { day: '2-digit', month: 'short' });
            const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

            const resultPayload = {
                name: currentStudent.name,
                class: currentStudent.class,
                score: score,
                correctCount: correctCount,
                totalQuestions: quizData.length,
                date: `${dateStr}, ${timeStr}`,
                timestamp: Date.now()
            };

            // Save automatically
            if (window.saveQuizResultToCloud) {
                window.saveQuizResultToCloud(resultPayload);
            }

            // Display Results
            showScreen('result-screen');
            document.getElementById('final-score').innerText = score;
            document.getElementById('final-subtext').innerText = `${correctCount} dari ${quizData.length} Soal Benar (${score}%)`;

            const starContainer = document.getElementById('star-rating');
            if (score === 100) {
                document.getElementById('res-emoji').innerText = '🏆';
                document.getElementById('res-title').innerText = 'Sempurna! Detektif Handal!';
                starContainer.innerText = '⭐ ⭐ ⭐';
                if (window.confetti) confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
            } else if (score >= 60) {
                document.getElementById('res-emoji').innerText = '🌟';
                document.getElementById('res-title').innerText = 'Bagus Sekali!';
                starContainer.innerText = '⭐ ⭐ ☆';
            } else {
                document.getElementById('res-emoji').innerText = '📘';
                document.getElementById('res-title').innerText = 'Tetap Semangat Belajar!';
                starContainer.innerText = '⭐ ☆ ☆';
            }

            // Render Answers Review
            const reviewList = document.getElementById('review-list');
            reviewList.innerHTML = '';
            userAnswers.forEach((ans, i) => {
                const item = document.createElement('div');
                item.className = `p-2.5 rounded-xl border-2 text-xs ${ans.isCorrect ? 'bg-emerald-50/90 border-emerald-200' : 'bg-rose-50/90 border-rose-200'}`;
                item.innerHTML = `
                    <div class="font-bold text-slate-800">${i + 1}. ${ans.question}</div>
                    <div class="mt-0.5 font-extrabold ${ans.isCorrect ? 'text-emerald-700' : 'text-rose-700'}">
                        Jawabanmu: ${ans.selected} ${ans.isCorrect ? '✅ (Benar)' : '❌ (Kurang Tepat)'}
                    </div>
                    <div class="text-slate-600 text-[11px] mt-1 bg-white/80 p-1.5 rounded-lg border border-slate-200/80">
                        💡 <strong>Penjelasan:</strong> ${ans.explanation}
                    </div>
                `;
                reviewList.appendChild(item);
            });
        }

        function restartQuiz() {
            showScreen('student-form-screen');
        }

        // Render Teacher Dashboard Table & Analytics
        window.renderResultsTable = function() {
            const tbody = document.getElementById('results-tbody');
            if (!tbody) return;

            const results = window.studentResults || [];
            const filterText = (document.getElementById('teacher-search')?.value || '').toLowerCase();

            const filtered = results.filter(r => 
                r.name.toLowerCase().includes(filterText) || 
                r.class.toLowerCase().includes(filterText)
            );

            // Update Stats
            document.getElementById('stat-total-students').innerText = results.length;
            if (results.length > 0) {
                const avg = Math.round(results.reduce((acc, curr) => acc + (curr.score || 0), 0) / results.length);
                document.getElementById('stat-avg-score').innerText = avg;
            } else {
                document.getElementById('stat-avg-score').innerText = '0';
            }

            tbody.innerHTML = '';
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400 italic">Belum ada data nilai siswa.</td></tr>`;
                return;
            }

            filtered.forEach((r, i) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition-colors';
                
                let scoreBadge = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                if (r.score < 60) scoreBadge = 'bg-rose-100 text-rose-800 border-rose-200';
                else if (r.score < 80) scoreBadge = 'bg-amber-100 text-amber-800 border-amber-200';

                tr.innerHTML = `
                    <td class="p-2 font-bold text-slate-400">${i + 1}</td>
                    <td class="p-2 font-bold text-slate-800">${r.name}</td>
                    <td class="p-2 font-extrabold text-purple-700">${r.class}</td>
                    <td class="p-2">
                        <span class="px-2 py-0.5 rounded-full border text-[10px] font-black ${scoreBadge}">
                            ${r.score}
                        </span>
                    </td>
                    <td class="p-2 text-[10px] text-slate-500">${r.date || '-'}</td>
                `;
                tbody.appendChild(tr);
            });
        };

        function confirmClearData() {
            if (confirm("Apakah Anda yakin ingin menghapus semua data rekap nilai siswa?")) {
                if (window.clearAllDataCloud) {
                    window.clearAllDataCloud();
                }
            }
        }

        function exportDataCSV() {
            const results = window.studentResults || [];
            if (results.length === 0) {
                alert("Belum ada data nilai untuk diexport!");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,No,Nama Siswa,Kelas,Skor,Jawaban Benar,Tanggal\n";
            results.forEach((r, i) => {
                csvContent += `${i + 1},"${r.name}","${r.class}",${r.score},${r.correctCount || score / 20},"${r.date}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Rekap_Nilai_Kuis_Bahasa_Indonesia_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Initialize Application
        window.onload = function() {
            showScreen('role-screen');
        };
    </script>
