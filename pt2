<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Bahasa Kelas 3 - Asesmen Formatif Bab 2: Kawan Seiring</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & Fredoka for fun, friendly typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        sans: ['Inter', 'sans-serif']
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985'
                        },
                        pastel: {
                            green: '#e6f4ea',
                            yellow: '#fef7e0',
                            purple: '#f3e8ff',
                            pink: '#fce7f3'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Fredoka', 'Inter', sans-serif;
            background-color: #f4f8fa;
            color: #2d3748;
            -webkit-tap-highlight-color: transparent;
        }
        .btn-bounce {
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-bounce:active {
            transform: scale(0.97);
        }
        .text-large-mode {
            font-size: 1.25rem !important;
        }
        .text-large-mode .option-text {
            font-size: 1.2rem !important;
        }
        .text-large-mode .q-title {
            font-size: 1.5rem !important;
        }
        /* Custom scrollbar for clean visual */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between p-3 sm:p-6 select-none">

    <!-- Top Bar & Mascot Header -->
    <header class="w-full max-w-3xl bg-white rounded-3xl shadow-sm border border-sky-100 p-4 sm:p-6 mb-4 transition-all">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <!-- Logo & Title Header -->
            <div class="flex items-center gap-3">
                <!-- SVG Illustration: Guru dan Siswa -->
                <div class="w-16 h-16 sm:w-20 sm:h-20 bg-sky-100 rounded-2xl flex items-center justify-center shrink-0 border-2 border-sky-200 overflow-hidden relative">
                    <svg class="w-14 h-14 text-sky-600" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Guru -->
                        <circle cx="35" cy="35" r="14" fill="#38bdf8"/>
                        <path d="M15 75C15 58 24 50 35 50C46 50 55 58 55 75" fill="#0284c7"/>
                        <!-- Glasses for teacher -->
                        <circle cx="30" cy="34" r="4" stroke="#ffffff" stroke-width="2"/>
                        <circle cx="40" cy="34" r="4" stroke="#ffffff" stroke-width="2"/>
                        <line x1="34" y1="34" x2="36" y2="34" stroke="#ffffff" stroke-width="2"/>
                        
                        <!-- Siswa -->
                        <circle cx="68" cy="42" r="11" fill="#f43f5e"/>
                        <path d="M52 80C52 66 59 60 68 60C77 60 84 66 84 80" fill="#e11d48"/>
                        <circle cx="68" cy="38" r="8" fill="#fecdd3"/>
                    </svg>
                </div>
                <div>
                    <span class="inline-block px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold tracking-wide uppercase mb-1">
                        Bahasa Indonesia Kelas 3 SD
                    </span>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-800 leading-snug">
                        Asesmen Formatif Bab 2
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 font-medium">
                        Tema: <span class="text-sky-600 font-semibold">"Kawan Seiring"</span>
                    </p>
                </div>
            </div>

            <!-- Accessibility Controls (ABK Friendly) -->
            <div class="flex items-center gap-2 bg-slate-50 p-2 rounded-2xl border border-slate-200">
                <!-- Text Size Toggle -->
                <button id="btnTextSize" title="Ubah Ukuran Teks" onclick="toggleTextSize()" class="p-2 sm:px-3 sm:py-2 bg-white hover:bg-sky-50 text-slate-700 rounded-xl border border-slate-200 text-xs font-bold flex items-center gap-1 btn-bounce shadow-sm">
                    <span class="text-base">Aa</span>
                    <span class="hidden sm:inline">Teks</span>
                </button>

                <!-- Audio Sound FX Toggle -->
                <button id="btnSound" title="Matikan/Hidupkan Suara" onclick="toggleSound()" class="p-2 sm:px-3 sm:py-2 bg-white hover:bg-sky-50 text-slate-700 rounded-xl border border-slate-200 text-xs font-bold flex items-center gap-1 btn-bounce shadow-sm">
                    <span id="soundIcon">🔊</span>
                    <span id="soundText" class="hidden sm:inline">Suara</span>
                </button>

                <!-- Text to Speech Button -->
                <button id="btnReadAloud" title="Bacakan Soal Ini" onclick="readCurrentQuestion()" class="p-2 sm:px-3 sm:py-2 bg-sky-500 hover:bg-sky-600 text-white rounded-xl text-xs font-bold flex items-center gap-1 btn-bounce shadow-sm">
                    <span>🗣️</span>
                    <span class="hidden sm:inline">Baca Soal</span>
                </button>
            </div>

        </div>
    </header>

    <!-- Main Quiz Card -->
    <main id="quizContainer" class="w-full max-w-3xl bg-white rounded-3xl shadow-md border border-slate-100 p-5 sm:p-8 flex-1 flex flex-col justify-between transition-all relative">
        
        <!-- Top Status Bar (Question Counter & Score) -->
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm" id="qNumBadge">1</span>
                <div>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Kemajuan</p>
                    <p class="text-sm font-bold text-slate-700">Soal <span id="currentQText">1</span> dari <span id="totalQText">10</span></p>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-1/3 sm:w-1/2 bg-slate-100 h-3 rounded-full overflow-hidden">
                <div id="progressBar" class="bg-gradient-to-r from-sky-400 to-indigo-500 h-full w-0 transition-all duration-300"></div>
            </div>

            <!-- Score Badge -->
            <div class="bg-amber-50 px-3 py-1.5 rounded-2xl border border-amber-200 flex items-center gap-1.5">
                <span class="text-base">⭐</span>
                <span class="text-sm font-bold text-amber-800" id="scoreText">0 Poin</span>
            </div>
        </div>

        <!-- Question Content Area -->
        <div class="flex-1 flex flex-col justify-center my-2">
            
            <!-- Category Tag -->
            <div class="mb-2">
                <span id="questionCategory" class="inline-block px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800">
                    Struktur Cerita
                </span>
            </div>

            <!-- Question Text -->
            <h2 id="questionTitle" class="q-title text-lg sm:text-xl font-bold text-slate-800 leading-relaxed mb-6">
                Memuat pertanyaan...
            </h2>

            <!-- Visual Helper / Context Box (if available) -->
            <div id="visualBox" class="mb-6 p-4 bg-sky-50 rounded-2xl border border-sky-100 hidden">
                <p id="visualText" class="text-sm sm:text-base text-sky-900 italic font-medium"></p>
            </div>

            <!-- Options Grid -->
            <div id="optionsContainer" class="grid grid-cols-1 gap-3 sm:gap-4">
                <!-- Option buttons dynamically inserted -->
            </div>

            <!-- Explanation Feedback Box (Shown after answer) -->
            <div id="feedbackBox" class="mt-6 p-4 rounded-2xl border hidden transition-all">
                <div class="flex items-start gap-3">
                    <span id="feedbackIcon" class="text-2xl">💡</span>
                    <div>
                        <h4 id="feedbackTitle" class="font-bold text-sm mb-1">Penjelasan:</h4>
                        <p id="feedbackText" class="text-xs sm:text-sm text-slate-700 leading-relaxed"></p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer Navigation -->
        <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between">
            <button id="btnPrev" onclick="prevQuestion()" disabled class="px-4 py-2.5 bg-slate-100 text-slate-400 font-bold text-sm rounded-2xl disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-200 transition btn-bounce">
                ⬅️ Sebelumnya
            </button>

            <button id="btnNext" onclick="nextQuestion()" disabled class="px-6 py-2.5 bg-sky-500 hover:bg-sky-600 text-white font-bold text-sm rounded-2xl shadow-md disabled:opacity-50 disabled:cursor-not-allowed transition btn-bounce flex items-center gap-2">
                <span>Lanjut</span>
                <span>➡️</span>
            </button>
        </div>

    </main>

    <!-- Result Screen Overlay (Hidden by default) -->
    <div id="resultModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 text-center shadow-2xl border border-white/20 transform transition-all">
            
            <div class="w-24 h-24 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center text-5xl mx-auto mb-4 border-4 border-amber-200 shadow-inner">
                🏆
            </div>

            <h2 class="text-2xl font-bold text-slate-800 mb-1">Hebat Sekali! 🎉</h2>
            <p class="text-slate-500 text-sm mb-6">Kamu telah menyelesaikan Asesmen Formatif Bab 2</p>

            <!-- Score Display Box -->
            <div class="bg-slate-50 rounded-2xl p-4 mb-6 border border-slate-200 grid grid-cols-2 gap-3">
                <div class="bg-white p-3 rounded-xl border border-slate-100">
                    <p class="text-xs text-slate-400 font-bold uppercase">Nilai Akhir</p>
                    <p id="finalScoreText" class="text-3xl font-extrabold text-sky-600">0</p>
                </div>
                <div class="bg-white p-3 rounded-xl border border-slate-100">
                    <p class="text-xs text-slate-400 font-bold uppercase">Jawaban Benar</p>
                    <p id="finalCorrectText" class="text-3xl font-extrabold text-emerald-500">0 / 10</p>
                </div>
            </div>

            <!-- Encouragement Message -->
            <p id="resultMessage" class="text-sm text-slate-700 font-medium mb-6 bg-sky-50 p-3 rounded-xl border border-sky-100">
                Kerja bagus! Terus semangat belajar Bahasa Indonesia ya!
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3">
                <button onclick="restartQuiz()" class="flex-1 py-3 bg-sky-500 hover:bg-sky-600 text-white font-bold rounded-2xl shadow-md transition btn-bounce">
                    🔄 Ulangi Kuis
                </button>
            </div>

        </div>
    </div>

    <script>
        // Comprehensive Question Bank for Bahasa Indonesia Kelas 3 Bab 2 "Kawan Seiring"
        const questionsData = [
            {
                category: "Struktur Cerita",
                question: "Bagian manakah dari cerita yang bertugas mengenalkan tokoh utama dan tempat kejadian cerita?",
                visual: "📖 Contoh: Pada suatu hari di sekolah, Lani dan Budi sedang duduk bersama...",
                options: [
                    "Bagian Awal Cerita",
                    "Bagian Tengah Cerita",
                    "Bagian Akhir Cerita"
                ],
                answer: 0,
                explanation: "Bagian AWAL cerita berisi pengenalan tokoh (siapa saja yang ada) dan tempat atau latar kejadian."
            },
            {
                category: "Fakta & Fiksi",
                question: "Manakah kalimat di bawah ini yang merupakan contoh KALIMAT FIKSI (khayalan)?",
                visual: "💭 Cerita fiksi adalah cerita buatan atau hasil imajinasi yang tidak terjadi di dunia nyata.",
                options: [
                    "Kucing itu tidur lelap di teras rumah.",
                    "Burung hantu itu memakai kacamata dan membaca buku cerita.",
                    "Anak-anak bermain bola di lapangan sekolah."
                ],
                answer: 1,
                explanation: "Burung hantu membaca buku adalah hal fiksi (imajinasi) karena hewan di dunia nyata tidak bisa membaca buku."
            },
            {
                category: "Fakta & Fiksi",
                question: "Kalimat: 'Matahari terbit di sebelah timur pada pagi hari.' Kalimat tersebut termasuk...",
                visual: "☀️ Kejadian ini benar-benar terjadi dan bisa kita lihat setiap hari.",
                options: [
                    "Kalimat Fiksi",
                    "Kalimat Fakta",
                    "Kalimat Dongeng"
                ],
                answer: 1,
                explanation: "Kalimat FAKTA adalah pernyataan tentang hal yang benar-benar nyata terjadi."
            },
            {
                category: "Struktur Cerita",
                question: "Masalah, peristiwa penting, dan pengalaman yang dialami tokoh terdapat pada bagian...",
                visual: "⚡ Contoh: Lani kehilangan pensil kesayangannya dan meminta bantuan Budi untuk mencari...",
                options: [
                    "Bagian Awal Cerita",
                    "Bagian Tengah Cerita",
                    "Bagian Akhir Cerita"
                ],
                answer: 1,
                explanation: "Bagian TENGAH cerita menceritakan peristiwa, petualangan, atau masalah yang dihadapi oleh tokoh."
            },
            {
                category: "Kalimat Tunggal",
                question: "Manakah di bawah ini yang merupakan contoh KALIMAT TUNGGAL?",
                visual: "📝 Kalimat tunggal hanya memiliki 1 Subjek (pelaku) dan 1 Predikat (kegiatan).",
                options: [
                    "Rani membaca buku di perpustakaan.",
                    "Rani membaca buku dan Budi menulis surat di kelas.",
                    "Rani membaca buku ketika hujan turun dengan deras."
                ],
                answer: 0,
                explanation: "'Rani membaca buku di perpustakaan' adalah kalimat tunggal karena terdiri dari 1 Subjek (Rani) & 1 Predikat (membaca)."
            },
            {
                category: "Sikap Berteman (Kawan Seiring)",
                question: "Ketika pensil temanmu jatuh ke lantai, sikap teman yang baik adalah...",
                visual: "🤝 Berteman baik berarti saling membantu dan peduli sesama teman.",
                options: [
                    "Melihatnya saja dan berpura-pura tidak tahu",
                    "Membantu mengambilkan pensil dengan ramah",
                    "Mentertawakan teman yang menjatuhkan pensil"
                ],
                answer: 1,
                explanation: "Teman yang baik senantiasa membantu temannya yang membutuhkan pertolongan dengan sikap yang ramah."
            },
            {
                category: "Kalimat Transitif & Intransitif",
                question: "Kalimat yang membutuhkan OBJEK agar kalimatnya menjadi utuh disebut kalimat...",
                visual: "🔍 Contoh: 'Budi membawa (apa?)' -> 'Budi membawa tas' (Tas = Objek)",
                options: [
                    "Kalimat Transitif",
                    "Kalimat Intransitif",
                    "Kalimat Tanya"
                ],
                answer: 0,
                explanation: "Kalimat TRANSITIF adalah kalimat yang membutuhkan objek (penderita/penerima tindakan)."
            },
            {
                category: "Kalimat Transitif & Intransitif",
                question: "Kalimat: 'Lani tertawa gembira.' Kalimat ini tidak memerlukan objek. Kalimat ini disebut...",
                visual: "😊 Kalimat ini sudah jelas maknanya tanpa perlu kata benda tambahan di belakangnya.",
                options: [
                    "Kalimat Transitif",
                    "Kalimat Intransitif",
                    "Kalimat Majemuk"
                ],
                answer: 1,
                explanation: "Kalimat INTRANSITIF adalah kalimat yang TIDAK memerlukan objek."
            },
            {
                category: "Kata Sapaan & Kesopanan",
                question: "Kata yang wajib kita ucapkan setelah menerima bantuan atau pemberian dari teman adalah...",
                visual: "🎁 Menghargai kebaikan teman dengan kalimat sopan.",
                options: [
                    "Minta maaf",
                    "Permisi",
                    "Terima kasih"
                ],
                answer: 2,
                explanation: "Mengucapkan 'Terima kasih' adalah bentuk kesopanan dan rasa menghargai bantuan teman."
            },
            {
                category: "Struktur Cerita",
                question: "Bagian cerita yang berisi penyelesaian masalah dan pesan moral (kesimpulan) terdapat pada...",
                visual: "🌈 Contoh: Akhirnya Budi dan Lani tersenyum dan berjanji akan selalu saling membantu...",
                options: [
                    "Bagian Awal Cerita",
                    "Bagian Tengah Cerita",
                    "Bagian Akhir Cerita"
                ],
                answer: 2,
                explanation: "Bagian AKHIR cerita memberikan kesimpulan, penyelesaian masalah, serta pesan kebaikan dari cerita."
            }
        ];

        let currentQuestionIndex = 0;
        let userAnswers = new Array(questionsData.length).fill(null);
        let score = 0;
        let soundEnabled = true;
        let isLargeText = false;

        // Web Audio API Synthesizer for sound effects
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function playSoundEffect(type) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) audioCtx = new AudioCtx();
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'correct') {
                    // Happy chime (C5 to G5)
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                    osc.frequency.exponentialRampToValueAtTime(783.99, audioCtx.currentTime + 0.15); // G5
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.3);
                } else if (type === 'wrong') {
                    // Soft low pop
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(130, audioCtx.currentTime + 0.2);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.2);
                } else if (type === 'click') {
                    // Gentle tap sound
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(400, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.08);
                }
            } catch (e) {
                console.log("Audio not supported or blocked");
            }
        }

        function readCurrentQuestion() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Stop current speech
                const q = questionsData[currentQuestionIndex];
                let textToRead = q.question + ". Pilihan jawaban: ";
                q.options.forEach((opt, idx) => {
                    textToRead += `Pilihan ${idx + 1}: ${opt}. `;
                });

                const utterance = new SpeechSynthesisUtterance(textToRead);
                utterance.lang = 'id-ID';
                utterance.rate = 0.9; // Slower rate for easy understanding
                window.speechSynthesis.speak(utterance);
            } else {
                alert("Fitur suara pembaca teks belum didukung di peramban ini.");
            }
        }

        function renderQuestion() {
            const q = questionsData[currentQuestionIndex];
            
            // Update progress & headers
            document.getElementById('qNumBadge').innerText = currentQuestionIndex + 1;
            document.getElementById('currentQText').innerText = currentQuestionIndex + 1;
            document.getElementById('totalQText').innerText = questionsData.length;
            
            const progressPercent = ((currentQuestionIndex + 1) / questionsData.length) * 100;
            document.getElementById('progressBar').style.width = `${progressPercent}%`;

            // Category & Question Title
            document.getElementById('questionCategory').innerText = q.category;
            document.getElementById('questionTitle').innerText = q.question;

            // Context Box
            const visualBox = document.getElementById('visualBox');
            const visualText = document.getElementById('visualText');
            if (q.visual) {
                visualText.innerText = q.visual;
                visualBox.classList.remove('hidden');
            } else {
                visualBox.classList.add('hidden');
            }

            // Options Grid
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            const selectedAns = userAnswers[currentQuestionIndex];

            q.options.forEach((optText, index) => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-2xl border-2 transition-all flex items-center justify-between font-medium btn-bounce option-text text-sm sm:text-base`;
                
                // Style based on selection status
                if (selectedAns === null) {
                    btn.classList.add('bg-white', 'border-slate-200', 'hover:border-sky-300', 'hover:bg-sky-50/50', 'text-slate-700');
                    btn.onclick = () => selectOption(index);
                } else {
                    // Disabled state after picking
                    btn.disabled = true;
                    if (index === q.answer) {
                        btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-900', 'font-bold');
                    } else if (index === selectedAns) {
                        btn.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-900');
                    } else {
                        btn.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-400', 'opacity-60');
                    }
                }

                // Inner content
                const letterBadge = String.fromCharCode(65 + index); // A, B, C
                btn.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center font-bold text-slate-600 text-xs shrink-0 border border-slate-200">
                            ${letterBadge}
                        </span>
                        <span>${optText}</span>
                    </div>
                    ${selectedAns !== null && index === q.answer ? '<span>✅</span>' : ''}
                    ${selectedAns !== null && index === selectedAns && index !== q.answer ? '<span>❌</span>' : ''}
                `;

                container.appendChild(btn);
            });

            // Feedback Box Handling
            const feedbackBox = document.getElementById('feedbackBox');
            const feedbackTitle = document.getElementById('feedbackTitle');
            const feedbackText = document.getElementById('feedbackText');
            const feedbackIcon = document.getElementById('feedbackIcon');

            if (selectedAns !== null) {
                feedbackBox.classList.remove('hidden');
                feedbackText.innerText = q.explanation;
                if (selectedAns === q.answer) {
                    feedbackBox.className = "mt-6 p-4 rounded-2xl border bg-emerald-50 border-emerald-200 text-emerald-900";
                    feedbackIcon.innerText = "🎉";
                    feedbackTitle.innerText = "Benar Sekali!";
                } else {
                    feedbackBox.className = "mt-6 p-4 rounded-2xl border bg-amber-50 border-amber-200 text-amber-900";
                    feedbackIcon.innerText = "💡";
                    feedbackTitle.innerText = "Pembahasan:";
                }
            } else {
                feedbackBox.classList.add('hidden');
            }

            // Navigation Buttons State
            document.getElementById('btnPrev').disabled = (currentQuestionIndex === 0);
            
            const btnNext = document.getElementById('btnNext');
            if (selectedAns !== null) {
                btnNext.disabled = false;
                if (currentQuestionIndex === questionsData.length - 1) {
                    btnNext.innerHTML = `<span>Selesai</span> <span>🏆</span>`;
                } else {
                    btnNext.innerHTML = `<span>Lanjut</span> <span>➡️</span>`;
                }
            } else {
                btnNext.disabled = true;
            }
        }

        function selectOption(index) {
            playSoundEffect('click');
            userAnswers[currentQuestionIndex] = index;
            
            const q = questionsData[currentQuestionIndex];
            if (index === q.answer) {
                score += 10;
                playSoundEffect('correct');
            } else {
                playSoundEffect('wrong');
            }

            document.getElementById('scoreText').innerText = `${score} Poin`;
            renderQuestion();
        }

        function nextQuestion() {
            playSoundEffect('click');
            // Cancel TTS if speaking
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();

            if (currentQuestionIndex < questionsData.length - 1) {
                currentQuestionIndex++;
                renderQuestion();
            } else {
                showResults();
            }
        }

        function prevQuestion() {
            playSoundEffect('click');
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();

            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                renderQuestion();
            }
        }

        function showResults() {
            playSoundEffect('correct');
            
            let correctCount = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questionsData[idx].answer) correctCount++;
            });

            document.getElementById('finalScoreText').innerText = score;
            document.getElementById('finalCorrectText').innerText = `${correctCount} / ${questionsData.length}`;

            const msg = document.getElementById('resultMessage');
            if (score >= 80) {
                msg.innerText = "🌟 Luar biasa! Kamu sudah sangat memahami materi Bab 2 Kawan Seiring!";
            } else if (score >= 60) {
                msg.innerText = "👍 Bagus sekali! Tingkatkan terus latihanmu ya!";
            } else {
                msg.innerText = "💪 Tetap semangat! Kamu bisa membaca ulang materi Bab 2 dan mencoba lagi!";
            }

            document.getElementById('resultModal').classList.remove('hidden');
        }

        function restartQuiz() {
            playSoundEffect('click');
            currentQuestionIndex = 0;
            userAnswers.fill(null);
            score = 0;
            document.getElementById('scoreText').innerText = `0 Poin`;
            document.getElementById('resultModal').classList.add('hidden');
            renderQuestion();
        }

        function toggleTextSize() {
            playSoundEffect('click');
            isLargeText = !isLargeText;
            const container = document.getElementById('quizContainer');
            if (isLargeText) {
                container.classList.add('text-large-mode');
                document.getElementById('btnTextSize').classList.add('bg-sky-100', 'text-sky-800');
            } else {
                container.classList.remove('text-large-mode');
                document.getElementById('btnTextSize').classList.remove('bg-sky-100', 'text-sky-800');
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('soundIcon').innerText = soundEnabled ? '🔊' : '🔇';
            document.getElementById('soundText').innerText = soundEnabled ? 'Suara' : 'Mute';
            if (soundEnabled) playSoundEffect('click');
        }

        // Initialize quiz on load
        window.onload = function() {
            renderQuestion();
        };
    </script>
</body>
</html>
